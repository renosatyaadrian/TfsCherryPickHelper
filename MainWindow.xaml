<Window x:Class="TfsCherryPickHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TfsCherryPickHelper"
        mc:Ignorable="d"
        Title="TFS Cherry-Pick Helper" Height="860" Width="1080" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Window.Resources>
        <!-- Modern button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Required-field label with red asterisk -->
        <Style x:Key="RequiredLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="TFS Cherry-Pick Helper" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                <TextBlock x:Name="RepoInfoText" Text="" FontSize="12" Foreground="#6B7280"
                           VerticalAlignment="Bottom" Margin="12,0,0,3" />
            </StackPanel>

            <!-- Account section (top-right) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="8" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HeaderCredentialDot" Width="8" Height="8" Fill="#9CA3AF"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderCredentialText" Text="Not logged in" FontSize="12"
                               Foreground="#6B7280" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Login..."
                            x:Name="HeaderLoginButton" Click="LoginButton_Click"
                            Padding="10,3" Margin="10,0,0,0" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TFS Connection (auto-detected from PR URL)" />
                        <TextBox x:Name="ConnectionInfoBox" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <!-- Connection status chip, tied to the Test Connection button -->
                        <Border x:Name="ConnectionChip" Background="#F3F4F6" CornerRadius="10"
                                Padding="10,4" HorizontalAlignment="Right" Margin="0,0,0,6"
                                ToolTip="Green = connection test succeeded.">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#9CA3AF"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="ConnectionText" Text="Not tested" FontSize="11"
                                           Foreground="#6B7280" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Content="Test Connection"
                                x:Name="TestConnectionButton" Click="TestConnectionButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource RequiredLabel}">
                            <Run Text="Local Repository Path" />
                            <Run Text="*" Foreground="#DC2626" FontWeight="Bold" />
                        </TextBlock>
                        <TextBox x:Name="LocalRepoPathBox" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}" Content="Browse..."
                                Click="BrowseRepoButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Output Excel Directory (default: project\output)" />
                        <TextBox x:Name="OutputDirBox" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}" Content="Browse..."
                                Click="BrowseOutputButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Input card -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CR Name -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource RequiredLabel}">
                        <Run Text="CR Name" />
                        <Run Text="*" Foreground="#DC2626" FontWeight="Bold" />
                    </TextBlock>
                    <TextBox x:Name="CrNameBox" Width="320" HorizontalAlignment="Left"
                             TextChanged="Inputs_Changed" />
                </StackPanel>

                <!-- PR Links -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource RequiredLabel}">
                        <Run Text="PR Links / IDs (one per line)" />
                        <Run Text="*" Foreground="#DC2626" FontWeight="Bold" />
                    </TextBlock>
                    <TextBox x:Name="PrLinksBox" Height="130" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"
                             TextChanged="Inputs_Changed" />
                </StackPanel>

                <!-- Process button -->
                <Button Grid.Row="2" x:Name="ProcessButton" Style="{StaticResource PrimaryButton}"
                        Content="Proses &amp; Generate Excel" HorizontalAlignment="Right" Margin="0,0,0,10"
                        Click="ProcessButton_Click" />

                <!-- Log -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Log / Status" />
                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"
                                 BorderThickness="0" Background="Transparent" Padding="8" />
                    </Border>
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="4" Background="#EEF2FF" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" Text="Ready." FontSize="12" Foreground="#3730A3" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
